# Port the server listens on
PORT=3000

# Public URL of the site, used in emails and calendar invites
PUBLIC_URL=https://ces.example.com

# Password for the admin dashboard at /admin (username is "admin")
ADMIN_PASSWORD=change-me

# Location of the SQLite database file
DB_PATH=./data/bookings.db

# Optional SMTP settings for confirmation emails. Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GigaDevice Americas <ces@example.com>"

# Comma separated internal addresses that get a copy of every booking
NOTIFY_EMAILS=
