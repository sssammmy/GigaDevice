# Port the server listens on
PORT=3000

# Public URL of the site, used in emails and calendar invites.
# On Render this is detected automatically.
PUBLIC_URL=

# Password for the admin dashboard at /admin (username is "admin")
ADMIN_PASSWORD=change-me

# Hosted Turso database (recommended for free hosting). Leave blank to use a local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local database file, used only when TURSO_DATABASE_URL is blank
DB_PATH=./data/bookings.db

# Email option 1 (use on Render free plan): Gmail relay. See tools/gmail-relay.gs
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Email option 2: SMTP. Only works on hosts that allow SMTP (not Render free).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GigaDevice Americas <ces@example.com>"

# Comma separated addresses that get an alert for every booking and cancellation
NOTIFY_EMAILS=
